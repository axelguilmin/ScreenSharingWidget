      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sur le réseau"
          }
        }
      }
    },
    "Add connections to this group in Screen Sharing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des connexions à ce groupe dans Partage d’écran."
          }
        }
      }
    },
    "All": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes"
          }
        }
      }
    },
    "All Connections": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les connexions"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique"
          }
        }
      }
    },
    "Choose Connection": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir la connexion"
          }
        }
      }
    },
    "Choose Connections": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir les connexions"
          }
        }
      }
    },
    "Click the menu bar icon to see all your connections. Use Pin to Menu Bar to give a computer its own icon.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur l’icône de la barre des menus pour voir toutes vos connexions. Utilisez « Épingler dans la barre des menus » pour donner à un ordinateur sa propre icône."
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter"
          }
        }
      }
    },
    "Connect to a computer with Screen Sharing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter à un ordinateur avec Partage d’écran."
          }
        }
      }
    },
    "Connect to “%@”": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter à « %@ »"
          }
        }
      }
    },
    "Connect to “%@”, offline": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter à « %@ », hors ligne"
          }
        }
      }
    },
    "Connection": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion"
          }
        }
      }
    },
    "Connections": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexions"
          }
        }
      }
    },
    "Control Center": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Centre de contrôle"
          }
        }
      }
    },
    "Control-click the desktop, choose Edit Widgets, then search for Screen Sharing. Control-click a widget and choose Edit to pick All Connections, Network or a group.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le bureau en maintenant la touche Contrôle, choisissez « Modifier les widgets », puis recherchez Partage d’écran. Cliquez sur un widget en maintenant la touche Contrôle et choisissez « Modifier » pour afficher Toutes les connexions, Réseau ou un groupe."
          }
        }
      }
    },
    "Desktop widget": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget de bureau"
          }
        }
      }
    },
    "Empty Group": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Groupe vide"
          }
        }
      }
    },
    "Failed to load recent connections": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du chargement des connexions récentes"
          }
        }
