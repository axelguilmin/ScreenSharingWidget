    "Show connections as icons, or in a list": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les connexions sous forme d’icônes ou de liste"
          }
        }
      }
    },
    "This group was deleted in Screen Sharing. Edit the widget to choose another one.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe a été supprimé dans Partage d’écran. Modifiez le widget pour en choisir un autre."
          }
        }
      }
    },
    "Untitled Group": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Groupe sans titre"
          }
        }
      }
    },
