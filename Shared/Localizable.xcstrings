        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Présentation par icônes"
          }
        }
      }
    },
    "In Control Center, click Edit Controls and add Screen Sharing to connect to a computer in one click.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le Centre de contrôle, cliquez sur « Modifier les commandes » et ajoutez Partage d’écran pour vous connecter à un ordinateur en un clic."
          }
        }
      }
    },
    "List View": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
