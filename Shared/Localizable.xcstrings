      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Présentation"
          }
        }
      }
    },
    "Welcome to Screen Sharing Widgets": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue dans Screen Sharing Widgets"
          }
        }
      }
    },
    "Your Screen Sharing connections, one click away.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos connexions Partage d’écran, en un clic."
          }
        }
      }
    },
    "macOS may ask to let this app access data from other apps (to read your Screen Sharing connections) and to find devices on your local network (to show the Network section). Nothing leaves your Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS peut vous demander d’autoriser cette app à accéder aux données d’autres apps (pour lire vos connexions Partage d’écran) et à rechercher des appareils sur votre réseau local (pour afficher la section Réseau). Rien ne quitte votre Mac."
          }
        }
      }
    }
  },
  "version": "1.0"
}